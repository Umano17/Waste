# Copia questo file in .env e riempi i valori. Il file .env non va mai su GitHub.

# Chiave Anthropic (console.anthropic.com) per leggere gli scontrini e preparare le ricette
ANTHROPIC_API_KEY=

# PIN per aprire la Dispensa dall'iPhone via Tailscale (almeno 4 cifre). Vuoto = accesso da fuori spento.
DISPENSA_PIN=

# Telegram (facoltativo): riepilogo del mattino. Vuoti = invio spento.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Facoltativi
DISPENSA_PORTA=8770
DISPENSA_MATTINO=si
DISPENSA_ORA_MATTINO=09:00
# Fascia in cui la Dispensa è disponibile e tiene sveglio il Mac ("sempre" = 24 ore su 24)
DISPENSA_ORARIO=09:00-20:00
DISPENSA_FUSO=Europe/Rome
DISPENSA_MODELLO=claude-sonnet-5-5
